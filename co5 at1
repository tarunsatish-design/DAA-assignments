#include <stdio.h>
#include <stdbool.h>

#define MAX_EDGES 20
#define MAX_VERTICES 20

// Structure to define a graph edge
typedef struct {
    int u;
    int v;
} Edge;

int max_matching = 0;

// Backtracking function with pruning
void backtrack(Edge edges[], int num_edges, int current_edge, int current_count, bool visited[]) {
    // Base case: If we have evaluated all edges
    if (current_edge == num_edges) {
        if (current_count > max_matching) {
            max_matching = current_count;
        }
        return;
    }

    // Branch 1: EXCLUDE the current edge and move to the next
    backtrack(edges, num_edges, current_edge + 1, current_count, visited);

    // Branch 2: INCLUDE the current edge (PRUNING STEP)
    int u = edges[current_edge].u;
    int v = edges[current_edge].v;

    // Only proceed if both vertices are free (independent)
    if (!visited[u] && !visited[v]) {
        // Mark vertices as used
        visited[u] = true;
        visited[v] = true;
        
        // Recurse with the edge included
        backtrack(edges, num_edges, current_edge + 1, current_count + 1, visited);
        
        // Backtrack: Undo the selection for other recursive branches
        visited[u] = false;
        visited[v] = false;
    }
}

int main() {
    // Simulated Graph: 5 Vertices, 6 Edges
    int num_vertices = 5;
    int num_edges = 6;
    
    Edge edges[] = {
        {0, 1}, {0, 2}, {1, 2}, 
        {1, 3}, {2, 4}, {3, 4}
    };

    // Array to track if a vertex is already part of an independent edge
    bool visited[MAX_VERTICES] = {false};

    printf("--- Maximum Independent Edge Set (Backtracking) ---\n");
    printf("Total Vertices: %d\n", num_vertices);
    printf("Total Edges: %d\n\n", num_edges);

    // Start the backtracking search
    backtrack(edges, num_edges, 0, 0, visited);

    printf("Maximum Independent Edges Found: %d\n", max_matching);

    return 0;
}
