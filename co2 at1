#include <stdio.h>
#include <stdbool.h>

// Structure to represent a 2D coordinate point
typedef struct {
    int x;
    int y;
} Point;

// Brute-force function to find the Convex Hull
void find_convex_hull(Point points[], int n) {
    if (n < 3) {
        printf("A convex hull requires at least 3 points.\n");
        return;
    }

    printf("Outer Boundary (Convex Hull) Edges:\n");

    // Check every pair of points (i, j)
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            int positive_count = 0, negative_count = 0;

            // Check where all other points (k) lie relative to the line (i, j)
            for (int k = 0; k < n; k++) {
                if (k == i || k == j) continue;

                // Cross-product formula to find side
                int val = (points[j].x - points[i].x) * (points[k].y - points[i].y) - 
                          (points[j].y - points[i].y) * (points[k].x - points[i].x);

                if (val > 0) positive_count++;
                else if (val < 0) negative_count++;
            }

            // If all points are strictly on one side, (i, j) is a boundary edge
            if (positive_count == 0 || negative_count == 0) {
                printf("Edge between (%d, %d) and (%d, %d)\n", 
                       points[i].x, points[i].y, points[j].x, points[j].y);
            }
        }
    }
}

int main() {
    // Array of simulated obstacle points
    Point obstacles[] = {
        {0, 3}, {1, 1}, {2, 2}, {4, 4},
        {0, 0}, {1, 2}, {3, 1}, {3, 3}
    };
    int n = sizeof(obstacles) / sizeof(obstacles[0]);

    printf("--- Robotics Obstacle Boundary Processor ---\n");
    find_convex_hull(obstacles, n);

    return 0;
}
