#include <stdio.h>

// --- DIVIDE AND CONQUER: MERGE SORT ---
void merge(int arr[], int left, int mid, int right) {
    int n1 = mid - left + 1;
    int n2 = right - mid;
    int L[n1], R[n2];

    for (int i = 0; i < n1; i++) L[i] = arr[left + i];
    for (int j = 0; j < n2; j++) R[j] = arr[mid + 1 + j];

    int i = 0, j = 0, k = left;
    while (i < n1 && j < n2) {
        if (L[i] <= R[j]) {
            arr[k] = L[i];
            i++;
        } else {
            arr[k] = R[j];
            j++;
        }
        k++;
    }
    while (i < n1) { arr[k] = L[i]; i++; k++; }
    while (j < n2) { arr[k] = R[j]; j++; k++; }
}

void merge_sort(int arr[], int left, int right) {
    if (left < right) {
        int mid = left + (right - left) / 2;
        merge_sort(arr, left, mid);
        merge_sort(arr, mid + 1, right);
        merge(arr, left, mid, right);
    }
}

// --- DIVIDE AND CONQUER: BINARY SEARCH ---
int binary_search(int arr[], int left, int right, int target) {
    while (left <= right) {
        int mid = left + (right - left) / 2;
        
        if (arr[mid] == target) return mid; // Log found
        if (arr[mid] < target) left = mid + 1;
        else right = mid - 1;
    }
    return -1; // Log not found
}

int main() {
    // Array of simulated log timestamps (e.g., Unix Epoch times)
    int event_logs[] = {169805, 169801, 169809, 169803, 169807, 169802, 169810};
    int n = sizeof(event_logs) / sizeof(event_logs[0]);
    int target_log = 169807;

    printf("--- Event Log Monitoring System ---\n");
    
    // Step 1: Sort the logs
    merge_sort(event_logs, 0, n - 1);
    printf("Logs Sorted (Merge Sort).\n");

    // Step 2: Search for a specific log
    int result_index = binary_search(event_logs, 0, n - 1, target_log);
    
    if (result_index != -1) {
        printf("Success: Target log %d found at index %d (Binary Search).\n", target_log, result_index);
    } else {
        printf("Error: Target log %d not found.\n", target_log);
    }

    return 0;
}
